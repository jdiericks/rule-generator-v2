# --- Database (Neon Postgres) ---
# Get the connection string from https://console.neon.tech/ (use a pooled
# connection URL when deploying serverless).
DATABASE_URL=

# --- NextAuth ---
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Required in production; leave unset locally for next-auth to infer from request.
NEXTAUTH_URL=http://localhost:3000

# --- GitHub OAuth app ---
# Register at https://github.com/settings/developers (or your org's settings).
# Authorization callback URL must be:  {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- Encryption secret for stored Anthropic API keys ---
# 64-char hex string (32 bytes). Generate with:
#   openssl rand -hex 32
SECRET_KEY=
